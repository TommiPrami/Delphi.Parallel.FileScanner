<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{71DECEEB-4555-4E7B-9730-A0AC259348E4}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Tests\ScannerTests\DPFSScannerTests.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Tests\UnitTests\DPFSUnitTests.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Tests\SimpleTestApp\DPFSSimpleTestAPP.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="DPFSScannerTests">
        <MSBuild Projects="Tests\ScannerTests\DPFSScannerTests.dproj"/>
    </Target>
    <Target Name="DPFSScannerTests:Clean">
        <MSBuild Projects="Tests\ScannerTests\DPFSScannerTests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DPFSScannerTests:Make">
        <MSBuild Projects="Tests\ScannerTests\DPFSScannerTests.dproj" Targets="Make"/>
    </Target>
    <Target Name="DPFSUnitTests">
        <MSBuild Projects="Tests\UnitTests\DPFSUnitTests.dproj"/>
    </Target>
    <Target Name="DPFSUnitTests:Clean">
        <MSBuild Projects="Tests\UnitTests\DPFSUnitTests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DPFSUnitTests:Make">
        <MSBuild Projects="Tests\UnitTests\DPFSUnitTests.dproj" Targets="Make"/>
